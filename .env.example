# Vercel frontend environment variables
# Use the public Razorpay key only. Keep the secret in Supabase Edge Function secrets.
VITE_RAZORPAY_KEY_ID=rzp_test_your_public_key

# Supabase Edge Function secrets are configured with `supabase secrets set`:
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# SUPABASE_ANON_KEY=your_anon_key
# RAZORPAY_KEY_ID=rzp_test_your_public_key
# RAZORPAY_KEY_SECRET=your_razorpay_secret
